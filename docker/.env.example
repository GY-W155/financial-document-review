# docker compose 会读取同目录 .env（复制本文件为 .env 填写）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_VISION_MODEL=deepseek-v4-flash-vision-exp
LLM_ENABLED=true
# 图片走 LLM 视觉；PDF 由 pymupdf 抽文本。图片本地 OCR 需装 paddleocr 并置 true
OCR_ENABLED=false
SECRET_KEY=change-me-in-production
