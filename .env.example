# 后端 .env 示例（复制为 backend/.env 使用；docker 部署则填 docker/.env）
DEBUG=false
DATABASE_URL=mysql+asyncmy://root:123456@127.0.0.1:3309/financial_doc_review?charset=utf8mb4
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 文件存储
STORAGE_DIR=uploads
MAX_UPLOAD_SIZE=52428800

# LLM（DeepSeek，OpenAI 兼容；可换成其它兼容服务）
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_VISION_MODEL=deepseek-v4-flash-vision-exp
LLM_ENABLED=true
# 图片 OCR：装 paddleocr 并置 true 走本地；否则图片走 LLM 视觉（deepseek-v4-flash-vision-exp）
# PDF 由服务端 pymupdf 抽文本，不经过 OCR/视觉。
OCR_ENABLED=false
