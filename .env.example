# 后端 .env 示例（复制为 backend/.env 使用）
DEBUG=false
DATABASE_URL=mysql+asyncmy://root:123456@127.0.0.1:3309/financial_doc_review
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 文件存储
STORAGE_DIR=uploads
MAX_UPLOAD_SIZE=52428800

# LLM（OpenAI 兼容：DeepSeek/Qwen/Kimi/GPT 等）
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
LLM_ENABLED=true
# 图片 OCR：安装 paddleocr 并置 true；未安装/关闭则走 LLM 视觉或降级 manual_review
OCR_ENABLED=false
